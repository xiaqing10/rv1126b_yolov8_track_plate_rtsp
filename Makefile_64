# =====================================================================
# aarch64 YOLO RTSP Makefile  (for atk_dlrv1126b_linux6.1_sdk, Buildroot aarch64)
# 用法: make -f Makefile_64
#
# 说明:
#   SDK 为 Buildroot 方案, 目标架构 aarch64 (BR2_aarch64=y).
#   - 编译器: SDK 自带 prebuilts 的 aarch64-none-linux-gnu (Ubuntu18.04 可运行)
#   - 库/头文件: 优先用 buildroot 输出的 sysroot (OpenCV4 / rknn / rkaiq / rga / mpp / asound / drm)
#   - rockit: external/rockit 的 arm64/rv1126b (aarch64 库 + rk_defines.h)
#   - librtsp.a: external/common_algorithm 的 aarch64 版本
#   - Eigen: 用宿主机的 /usr/include/eigen3 (纯头文件, 与架构无关)
# 注意: 本工程 lib/ 下的 *.so 是旧的 32 位 armhf, 与本 SDK(aarch64)不匹配,
#       因此这里不再链接工程 lib/ 目录, 全部使用 SDK 的 aarch64 库。
# =====================================================================
P        := $(shell pwd)
SDK      := /linux/rv1126b/atk_dlrv1126b_linux6.1_sdk
CAR      := $(P)/src/car

# ===== aarch64 交叉编译器 (SDK prebuilts) =====
TOOLCHAIN := $(SDK)/buildroot/output/alientek_rv1126b/host/
CROSS    := $(TOOLCHAIN)/bin/aarch64-linux-
CC       := $(CROSS)gcc
CXX      := $(CROSS)g++
AR       := $(CROSS)ar

# ===== Buildroot 输出 sysroot (OpenCV4 / rknn / rkaiq / rga / mpp / asound / drm) =====
SYS      := $(SDK)/buildroot/output/alientek_rv1126b/host/aarch64-buildroot-linux-gnu/sysroot
SYSROOT  := $(shell $(CC) -print-sysroot)
CFLAGS   += --sysroot=$(SYSROOT)

# ---- rockit / mpi 头 + arm64 库 ----
RK_MPI_INC := $(SDK)/external/rockit/mpi/sdk/include
RK_DEFINES := $(SDK)/external/rockit/lib/arm64/rv1126b
RK_LIB     := $(SDK)/external/rockit/lib/arm64/rv1126b/linux
# ---- rkaiq 头 (buildroot sysroot) ----
RKAIQ_INC  := -I$(SYS)/usr/include/rkaiq -I$(SYS)/usr/include/rkaiq/uAPI2
# ---- rknn 头 ----
RKNN_INC   := -I$(SYS)/usr/include/rknn
# ---- RTSP 库 (aarch64 版本) + 头 ----
RTSP_A     := $(SDK)/external/common_algorithm/misc/lib/aarch64-rockchip1240-linux-gnu/librtsp.a
RTSP_INC   := -I$(P)/include/rtsp -I$(SDK)/external/common_algorithm/misc/include

# 头文件路径 (OpenCV4 优先于工程内 opencv2 shim)
INCS := -I$(SYS)/usr/include/opencv4 \
        -I$(CAR) -I$(P)/include -I$(P)/include/deepsort -I$(P)/include/bytetrack -I$(P)/citradar_ab02 \
        -I$(RK_MPI_INC) -I$(RK_DEFINES) $(RKNN_INC) \
        $(RKAIQ_INC) $(RTSP_INC) -I/linux/rv1126b/atk_dlrv1126b_linux6.1_sdk/yolo_rtsp_app/include/eigen-3.4.0/

# aarch64: armv8-a, 无 EIGEN_DONT_ALIGN 需求
CFLAGS := -g -Wall -O2 -fno-omit-frame-pointer -DRV1126B -DUAPI2 -DRKPLATFORM=ON -DARCH64=ON \
          -march=armv8-a -fopenmp $(INCS)
CXXFLAGS := $(CFLAGS) -std=c++14

LIBDIR := -L$(SYS)/usr/lib -L$(RK_LIB)

# OpenCV 4.9 及其依赖编解码库
OPENCV_LIBS := -lopencv_imgcodecs -lopencv_imgproc -lopencv_core \
               -ljpeg -lpng -ltiff -lwebp -lz

LIBS := -Wl,--start-group \
        $(RTSP_A) \
        -lrockit -lrockchip_mpp -lrkaiq -lrga -lrknnrt \
        -lasound -ldrm \
        $(OPENCV_LIBS) \
        -lpthread -lm -lstdc++ -ldl -fopenmp \
        -Wl,--end-group
LDFLAGS := $(LIBDIR) $(LIBS) -Wl,-rpath,/oem/usr/lib:/oem/lib -Wl,--gc-sections -Wl,--as-needed

# ---- YOLO 推理源码 ----
YOLO_SRC := src/yolo/yolov8.cc src/yolo/postprocess.cc \
            src/image_utils.cc src/file_utils.cc
# ---- ByteTrack 跟踪 ----
TRACK_SRC := src/bytetrack/BYTETracker.cpp src/bytetrack/STrack.cpp \
             src/bytetrack/kalmanFilter.cpp src/bytetrack/lapjv.cpp \
             src/bytetrack/utils.cpp
# ---- DeepSORT 跟踪 ----
DEEPSORT_SRC := src/deepsort/kalmanfilter.cpp src/deepsort/track.cpp \
                src/deepsort/tracker.cpp src/deepsort/nn_matching.cpp \
                src/deepsort/linear_assignment.cpp src/deepsort/hungarianoper.cpp \
                src/deepsort/reid_rknn.cpp src/deepsort/deepsort_integ.cpp
# ---- 车/车牌识别库 ----
CAR_LIB_SRC := $(CAR)/detect.cc $(CAR)/plate_rec.cc $(CAR)/car_color.cc \
               $(CAR)/pipeline.cc $(CAR)/lprnet.cc
CAR_INTEG_SRC := src/car_worker.cc src/car_integ.cc
# ---- TCP + NDJSON 输出 ----
TCP_SRC := src/tcp_output.cc
# ---- CitRadar AB02 协议 ----
AB02_SRC := citradar_ab02/citradar_ab02.cpp

# ---- 小工具: 解码 -> RTSP ----
TEST_RTSP_LIBS := -Wl,--start-group $(RTSP_A) -lrockit -lrockchip_mpp \
                  -lrga -lasound -ldrm -lpthread -lm -ldl -Wl,--end-group

test_vdec_h264_rtsp: src/test_vdec_h264_rtsp.c
	$(CC) $(CFLAGS) $< -o $@ $(LIBDIR) $(TEST_RTSP_LIBS) -Wl,-rpath,/oem/usr/lib:/oem/lib -Wl,--gc-sections -Wl,--as-needed
	@echo "build test_vdec_h264_rtsp OK"

test_vdec_vpss_venc_rtsp: src/test_vdec_vpss_venc_rtsp.c
	$(CC) $(CFLAGS) $< -o $@ $(LIBDIR) $(TEST_RTSP_LIBS) -Wl,-rpath,/oem/usr/lib:/oem/lib -Wl,--gc-sections -Wl,--as-needed
	@echo "build test_vdec_vpss_venc_rtsp OK"

# ---- Web control daemon (standalone, pthread+dl only) ----
web/yolo_web: web/yolo_web.c
	$(CC) -O2 -Wall -o web/yolo_web web/yolo_web.c -pthread -ldl
	@echo "build web/yolo_web OK"

default: all

stream_demo: src/simple_vi_bind_venc_rtsp.c
	$(CC) $(CFLAGS) $< -o $@ $(LDFLAGS)
	@echo "build stream_demo OK"

yolo_img_test: src/yolo_img_test.cc $(YOLO_SRC)
	$(CXX) $(CXXFLAGS) $^ -o $@ $(LDFLAGS)
	@echo "build yolo_img_test OK"

lib/libcar.a: $(CAR_LIB_SRC) $(CAR)/car_recognition.h
	@mkdir -p lib
	$(CXX) $(CXXFLAGS) -c $(CAR_LIB_SRC)
	$(AR) rcs $@ detect.o plate_rec.o car_color.o pipeline.o lprnet.o
	@rm -f detect.o plate_rec.o car_color.o pipeline.o lprnet.o
	@echo "build lib/libcar.a OK"

car_img_test: src/car_img_test.cc lib/libcar.a
	$(CXX) $(CXXFLAGS) $< -o $@ lib/libcar.a $(LIBDIR) $(LIBS)
	@echo "build car_img_test OK"

yolo_rtsp: src/yolo_rtsp.cc $(YOLO_SRC) $(TRACK_SRC) $(DEEPSORT_SRC) $(CAR_INTEG_SRC) $(TCP_SRC) $(AB02_SRC) lib/libcar.a
	$(CXX) $(CXXFLAGS) -DCITRADAR_AB02_NO_MAIN $^ -o $@ $(LDFLAGS)
	@echo "build yolo_rtsp OK"

all: stream_demo yolo_img_test car_img_test yolo_rtsp web/yolo_web

clean:
	rm -f stream_demo yolo_img_test car_img_test yolo_rtsp web/yolo_web
	rm -f lib/libcar.a
